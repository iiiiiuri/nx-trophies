        "p1.lakitu_timer": { "from": "p1_kart", "offset": "0x830", "confidence": "community", "note": "cheat 'Lakitu Pickup'" },
        "p1.status":       { "from": "p1_kart", "offset": "0x7A4", "confidence": "assumed", "note": "cheats escrevem 0x00801000 (normal) e 0x00A01000 (Bullet Bill); o bit 0x00200000 é inferido" },
        "p1.coins":        { "confidence": "to_discover", "note": "Breeze: busca u8 exata 0, pegar moedas, refinar por valor; depois achar a cadeia a partir de main" },
        "race.finished":   { "confidence": "to_discover", "note": "flag que muda na chegada; provavelmente na mesma estrutura de p1_kart" },
        "race.final_rank": { "confidence": "to_discover", "note": "busca u8 pela posição exibida durante a corrida (1..12)" },
        "cup.best_trophy_150cc": { "confidence": "to_discover", "index_key": "trophy_index", "note": "tabela do save em memória; descobrir offset base, stride e trophy_index de cada copa" }
      }
    }
  ],

  "events": [
    { "id": "star_used",     "when": { "value": "p1.star_timer",   "op": ">", "rhs": 0 } },
    { "id": "ghost_used",    "when": { "value": "p1.ghost_timer",  "op": ">", "rhs": 0 } },
    { "id": "squished",      "when": { "value": "p1.squish_timer", "op": ">", "rhs": 0 } },
    { "id": "shocked",       "when": { "value": "p1.shock_timer",  "op": ">", "rhs": 0 } },
    { "id": "lakitu_rescue", "when": { "value": "p1.lakitu_timer", "op": ">", "rhs": 0 } },
    { "id": "bullet_bill",   "when": { "value": "p1.status", "op": "has_any", "rhs": "0x00200000" } },
    { "id": "race_won",      "when": { "all": [
        { "value": "race.finished",   "op": "==", "rhs": 1 },
        { "value": "race.final_rank", "op": "==", "rhs": 1 }
    ] } }

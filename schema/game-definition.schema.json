{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://switch-achievements/schema/game-definition.schema.json",
  "title": "Switch Achievements: definição de jogo (schema v2)",
  "description": "Estrutura padrão de games/<id>.json. O validador oficial é `python3 tools/sa.py validate`; este schema serve para autocompletar e apontar erros no editor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game", "variables", "bindings", "achievements"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "game": { "$ref": "#/definitions/game" },
    "content": {
      "description": "Catálogos do jogo (copas, masmorras, itens...). Cada entrada carrega a chave que o jogo usa na memória.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_]*$" },
      "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/contentEntry" } }
    },
    "variables": {
      "description": "Estado observável do jogo, independente de versão.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_.]*$" },
      "additionalProperties": { "$ref": "#/definitions/variable" }
    },
    "bindings": {
      "description": "Onde cada variável mora, por build do jogo (memory) ou por formato de save (save_json).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/binding" }
    },
    "events": { "type": "array", "items": { "$ref": "#/definitions/event" } },
    "achievements": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/achievement" } }
  },
  "definitions": {
    "hex16": { "type": "string", "pattern": "^[0-9A-Fa-f]{16}$" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.]*$" },
    "integerLike": {
      "description": "Inteiro, ou string decimal/hex (\"0x1CC0760\").",
      "oneOf": [{ "type": "integer" }, { "type": "string", "pattern": "^(0x[0-9A-Fa-f]+|0b[01]+|-?[0-9]+)$" }]
    },
    "text": {
      "description": "Texto simples ou mapa idioma -> texto ({\"pt-BR\": ..., \"en\": ...}).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    },
    "confidence": {
      "description": "verified/community: ativo · assumed: ensaio (não desbloqueia) · to_discover: não avaliado.",
      "enum": ["verified", "community", "assumed", "to_discover"]
    },
    "type": { "enum": ["u8", "s8", "u16", "s16", "u32", "s32", "u64", "s64", "f32", "f64"] },
    "region": { "enum": ["main", "heap", "alias", "aslr"] },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$", "description": "Igual ao nome do arquivo sem .json." },
        "name": { "$ref": "#/definitions/text" },
        "kind": { "enum": ["retail", "homebrew"], "default": "retail" },
        "title_ids": { "type": "array", "items": { "$ref": "#/definitions/hex16" }, "description": "Obrigatório para retail." },
        "notes": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
      },
      "if": { "properties": { "kind": { "const": "retail" } } },
      "then": { "required": ["title_ids"] }
    },
    "contentEntry": {
      "description": "Campos livres por jogo. Convenções: slot/index (posição numa tabela), bit ou mask (bitfield), value (código do item), confidence.",
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" },
        "name": { "$ref": "#/definitions/text" },
        "bit": { "type": "integer", "minimum": 0, "maximum": 63 },
        "mask": { "$ref": "#/definitions/integerLike" },
        "confidence": { "$ref": "#/definitions/confidence" }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/definitions/type" },
        "indexed_by": { "type": "string", "description": "Conjunto de content: gera uma instância por entrada (var[entrada])." },
        "description": { "type": "string" }
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "chain"],
      "properties": {
        "base": { "$ref": "#/definitions/region" },
        "chain": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/integerLike" },
                   "description": "[a, b] = [[base+a]+b]: lê um u64 em cada nível." },
        "note": { "type": "string" }
      }
    },
    "bindingVariable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/definitions/region" },
        "from": { "type": "string", "description": "Id de um ponteiro do binding." },
        "offset": { "$ref": "#/definitions/integerLike" },
        "stride": { "$ref": "#/definitions/integerLike", "description": "Distância entre entradas de variável indexed_by." },
        "index_key": { "type": "string", "description": "Campo da entrada de content usado como índice (padrão: index)." },
        "path": { "type": "string", "description": "Caminho no save JSON; aceita {item.campo} e {item.key}." },
        "type": { "$ref": "#/definitions/type" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "note": { "type": "string", "description": "Fonte do endereço, ou dica de busca quando to_discover." }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "match", "variables"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "source": { "enum": ["memory", "save_json"] },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "build_ids": { "type": "array", "items": { "$ref": "#/definitions/hex16" } },
            "files": { "type": "array", "items": { "type": "string" } }
          }
        },
        "pointers": { "type": "object", "additionalProperties": { "$ref": "#/definitions/pointer" } },
        "active_when": { "$ref": "#/definitions/condition" },
        "aliases": { "type": "object", "additionalProperties": { "type": "string" } },
        "instance_modes": { "type": "object", "additionalProperties": { "$ref": "#/definitions/condition" } },
        "poll_ms": { "type": "integer", "minimum": 50 },
        "variables": { "type": "object", "additionalProperties": { "$ref": "#/definitions/bindingVariable" } },
        "notes": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "memory" } } },
          "then": { "properties": { "match": { "required": ["build_ids"] } } }
        },
        {
          "if": { "properties": { "source": { "const": "save_json" } } },
          "then": { "properties": { "match": { "required": ["files"] } }, "not": { "required": ["pointers"] } }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "when": { "$ref": "#/definitions/condition", "description": "Conta +1 quando passa de falso para verdadeiro." },
        "description": { "type": "string" }
      }
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "condition"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "name": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "xp": { "type": "integer", "minimum": 0 },
        "rarity": { "enum": ["common", "uncommon", "rare", "epic", "legendary"] },
        "secret": { "type": "boolean" },
        "condition": { "$ref": "#/definitions/condition" },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "target"],
          "properties": { "value": { "$ref": "#/definitions/value" }, "target": { "$ref": "#/definitions/integerLike" } }
        },
        "modes": { "type": "array", "items": { "type": "string" } },
        "confirm_ticks": { "type": "integer", "minimum": 1 },
        "for_each": { "type": "string", "description": "Template: uma conquista por entrada do conjunto de content ({item.campo})." },
        "where_has": { "type": "string", "description": "Template: só entradas que têm este campo." }
      }
    },
    "condition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "items": { "$ref": "#/definitions/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "items": { "$ref": "#/definitions/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/definitions/condition" } } },
        { "type": "object", "additionalProperties": false, "required": ["exists"], "properties": { "exists": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["for_all", "condition"], "properties": { "for_all": { "type": "string" }, "condition": { "$ref": "#/definitions/condition" } } },
        { "type": "object", "additionalProperties": false, "required": ["for_any", "condition"], "properties": { "for_any": { "type": "string" }, "condition": { "$ref": "#/definitions/condition" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "op", "rhs"],
          "properties": {
            "value": { "$ref": "#/definitions/value" },
            "op": { "enum": ["==", "!=", "<", "<=", ">", ">=", "has_all", "has_any"] },
            "rhs": { "$ref": "#/definitions/value" }
          }
        }
      ]
    },
    "value": {
      "description": "Nome de variável, número, string numérica (\"0x0F\") ou operação.",
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "object", "additionalProperties": false, "required": ["var"], "properties": { "var": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["const"], "properties": { "const": { "$ref": "#/definitions/integerLike" } } },
        { "type": "object", "additionalProperties": false, "required": ["count"], "properties": { "count": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["truth"], "properties": { "truth": { "$ref": "#/definitions/condition" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["popcount"],
          "properties": { "popcount": { "type": "object", "additionalProperties": false, "required": ["value"],
            "properties": { "value": { "$ref": "#/definitions/value" }, "mask": { "$ref": "#/definitions/value" } } } }
        },
        { "type": "object", "additionalProperties": false, "required": ["sum"], "properties": { "sum": { "type": "array", "items": { "$ref": "#/definitions/value" } } } },
        { "type": "object", "additionalProperties": false, "required": ["div"], "properties": { "div": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/value" } } } },
        {
          "type": "object", "additionalProperties": false, "required": ["content_mask"],
          "properties": { "content_mask": { "type": "object", "additionalProperties": false, "required": ["of"],
            "properties": { "of": { "type": "string" }, "key": { "type": "string" } } } }
        },
        { "type": "object", "additionalProperties": false, "required": ["count_of", "condition"], "properties": { "count_of": { "type": "string" }, "condition": { "$ref": "#/definitions/condition" } } }
      ]
    }
  }
}
